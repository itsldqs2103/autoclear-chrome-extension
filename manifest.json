{
  "manifest_version": 3,
  "name": "Startup Browsing Data Cleaner",
  "version": "1.0",
  "description": "Automatically clears browsing data each time Chrome starts.",
  "permissions": ["browsingData"],
  "background": {
    "service_worker": "dist/script.js"
  },
  "action": {
    "default_title": "Startup Browsing Data Cleaner"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
