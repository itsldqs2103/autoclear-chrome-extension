{
  "manifest_version": 3,
  "name": "AutoClear",
  "version": "1.0.0",
  "description": "Automatically clear browsing data on browser startup.",
  "permissions": ["browsingData"],
  "background": {
    "service_worker": "dist/script.js"
  },
  "action": {
    "default_title": "AutoClear"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
